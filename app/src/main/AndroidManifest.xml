<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Both hosts: without the entry here getPackageUid and getLaunchIntentForPackage see nothing. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- For ActivityManager.killBackgroundProcesses on the host. Both kills always run; Android 14
         and later ignores this one for other apps, so the su force-stop is what actually works there. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- The update check and its download; only the settings app reaches the network, never the code in WhatsApp. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tells you the download finished; best effort, since the Updates screen shows the same state and its own Install button. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hands the downloaded APK to the system installer; nothing installs without its own confirm dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Scoped storage blocks the public Download/ write the cropped wallpaper needs on API 30+.
         The user is sent to "All files access" on the first wallpaper pick if it is not granted. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/app_desc"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaThemer"
        tools:targetApi="33">

        <activity
            android:name=".settings.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WaThemer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- UCrop ships an empty manifest, so its activity is declared here; keep its AppCompat theme, UCrop threw on launch under the app's. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Serves user fonts to the WhatsApp hook. Exported unprotected on purpose: WhatsApp cannot
             hold a permission of ours, and this is read-only and jailed to the fonts dir. -->
        <provider
            android:name=".FontProvider"
            android:authorities="${applicationId}.fonts"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Serves chat wallpapers to the WhatsApp hook. Exported like the font provider and jailed to its
             own dir, and it answers only WhatsApp and this app: these pictures are per contact. -->
        <provider
            android:name=".ChatWallpaperProvider"
            android:authorities="${applicationId}.wallpapers"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Theme shares and the downloaded update; not exported, each receiver gets a one-shot read on its one Uri. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- The Xposed module is declared in META-INF/xposed/; android:description is the text the manager lists. -->

    </application>

</manifest>
