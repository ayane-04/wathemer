<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.whatsapp" />
    </queries>

    <!-- Required for ActivityManager.killBackgroundProcesses("com.whatsapp"). Non-root
         primary path for the "Restart WhatsApp" button. Root (su) is used as fallback. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- The update check and its download. Only the settings app reaches the network; the code
         inside WhatsApp never does. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tells you the download finished. Best effort: the Updates screen carries the same state
         and its own Install button, so a denied permission costs nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hands the downloaded APK to the system installer, which shows its own confirm dialog.
         Nothing is installed without that dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- MANAGE_EXTERNAL_STORAGE: needed to write the cropped wallpaper to
         /sdcard/Download/WaThemer/wallpaper.png on API 30+ (scoped storage blocks
         public Download/ writes otherwise). User is sent to the system "All files
         access" settings on first wallpaper pick when not yet granted. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/app_desc"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaThemer"
        tools:targetApi="33">

        <!-- Settings launcher -->
        <activity
            android:name=".settings.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WaThemer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- UCrop ships an empty manifest, so its activity is declared here. The AppCompat
             theme is forced: UCrop inflates AppCompat widgets and throws under Material3. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Serves user fonts to the WhatsApp hook. Exported without a permission on purpose:
             WhatsApp cannot hold one of ours, the content is a font the user chose to show
             on screen, and the provider is read-only and jailed to the fonts dir. -->
        <provider
            android:name=".FontProvider"
            android:authorities="${applicationId}.fonts"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Hands a saved theme file to the share sheet. Not exported: the receiving app is granted
             a one-shot read on the single Uri in the intent, and nothing else is reachable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Modern module: the declaration lives in META-INF/xposed/, the description here. -->

    </application>

</manifest>
